; Engine configuration file.
; This validated preview can also load an external production pet manifest.

config_version=5

[application]

config/name="Godot Textured Rig Pet Prototype"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
boot_splash/show_image=false

[display]

window/size/viewport_width=900
window/size/viewport_height=760
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/size/window_width_override=900
window/size/window_height_override=760
window/per_pixel_transparency/allowed=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
viewport/transparent_background=true
